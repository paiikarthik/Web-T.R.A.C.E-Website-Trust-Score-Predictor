{
  "dataset": "PhiUSIIL_Phishing_URL_Dataset.csv",
  "evaluation_mode": "honest_domain",
  "n_rows_after_clean": 235370,
  "n_features": 14,
  "features": [
    "DomainLength",
    "IsDomainIP",
    "TLDLength",
    "NoOfSubDomain",
    "HasObfuscation",
    "NoOfObfuscatedChar",
    "netloc_entropy",
    "hyphen_domain",
    "dot_domain",
    "kw_count",
    "has_kw",
    "is_susp_tld",
    "digits_domain",
    "digit_ratio_domain"
